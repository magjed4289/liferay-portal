<html>
<head>
<title>CKEditorBalloonEditorSample</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
	<tr><td rowspan="1" colspan="3">CKEditorBalloonEditorSample</td></tr>
</thead>

<tbody>
<!--HYPERLINK_TOOLBAR_ELEMENTS-->
<tr>
	<td>HYPERLINK_UNLINK</td>
	<td>//div[@class='cke_balloon_content']//a[@title='Unlink']</td>
	<td></td>
</tr>
<tr>
	<td>HYPERLINK_TARGET</td>
	<td>//select[contains(@class,'ui-select') and contains(@name,'Target')]</td>
	<td></td>
</tr>
<tr>
	<td>HYPERLINK_TEXT_INPUT</td>
	<td>//input[contains(@class,'ui-textinput') and contains(@placeholder,'Link')]</td>
	<td></td>
</tr>
<tr>
	<td>HYPERLINK_BROWSE_SRVR_BTN</td>
	<td>//a[contains(@class,'cke_button') and contains(@title,'Browse Server')]</td>
	<td></td>
</tr>
<tr>
	<td>HYPERLINK_CHK_BTN</td>
	<td>//a[contains(@class,'cke_button')]//span[contains(@class,'check_icon')]</td>
	<td></td>
</tr>
<!--TOOLBAR_ELEMENTS-->
<tr>
	<td>TOOLBAR_ANY_ITEM_BUTTON</td>
	<td>//a[contains(@href,"${key_titleName}")]</td>
	<td></td>
</tr>
<!--PARAGRAPH-->
<tr>
	<td>BODY_TEXT</td>
	<td>//div[@class='portlet-body']/div/div/p[1]</td>
	<td></td>
</tr>
<tr>
	<td>BODY_TEXT_HYPERLINK</td>
	<td>//div[@class='portlet-body']/div/div/p[2]/a</td>
	<td></td>
</tr>
<tr>
	<td>PARAGRAPH_ASSERT_BODY_TEXT_CONTENT_BOLD</td>
	<td>//div[(@class='portlet-body')]//p//strong[contains(text(),'${key_textName}')]</td>
	<td></td>
</tr>
<tr>
	<td>PARAGRAPH_ASSERT_BODY_TEXT_CONTENT_BULLET_LIST</td>
	<td>//div[(@class='portlet-body')]//ul/li[contains(text(),'${key_textName}')]</td>
	<td></td>
</tr>
<tr>
	<td>PARAGRAPH_ASSERT_BODY_TEXT_CONTENT_ITALIC</td>
	<td>//div[(@class='portlet-body')]//p//em[contains(text(),'${key_textName}')]</td>
	<td></td>
</tr>
<tr>
	<td>PARAGRAPH_ASSERT_BODY_TEXT_CONTENT_UNDERLINE</td>
	<td>//div[(@class='portlet-body')]//p//u[contains(text(),'${key_textName}')]</td>
	<td></td>
</tr>
<tr>
	<td>PARAGRAPH_CONTENT_NUMBERED_LIST</td>
	<td>//div[(@class='portlet-body')]//ol/li</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>