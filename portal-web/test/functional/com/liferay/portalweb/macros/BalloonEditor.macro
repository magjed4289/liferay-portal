definition {

	macro addTable {
		AssertElementPresent(locator1 = "CKEditorBalloonEditorSample#INSERT_BTN");

		Click(locator1 = "CKEditorBalloonEditorSample#INSERT_BTN");

		Click(locator1 = "CKEditorBalloonEditorSample#INSERT_TABLE_BTN");

		Click(locator1 = "CKEditorBalloonEditorSample#CHK_BTN_TABLE");
	}

	macro clearParagraphWithBackspace {
		TripleClick(locator1 = "${paragraph}");

		KeyPress(
			locator1 = "${paragraph}",
			value1 = "\BACK_SPACE");
	}

	macro toggleBalloonEditorContentStyle {
		TripleClick(locator1 = "CKEditorBalloonEditorSample#BODY_TEXT");

		WaitForElementPresent(
			key_titleName = "${optionTool}",
			locator1 = "CKEditorBalloonEditorSample#TOOLBAR_ANY_ITEM_BUTTON");

		Click(
			key_titleName = "${optionTool}",
			locator1 = "CKEditorBalloonEditorSample#TOOLBAR_ANY_ITEM_BUTTON");
	}

}